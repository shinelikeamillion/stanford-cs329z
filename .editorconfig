root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# trailing double-space is never used for line breaks in this repo
trim_trailing_whitespace = true
max_line_length = off

[Makefile]
indent_style = tab
